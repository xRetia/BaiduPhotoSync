{
  "name": "baiduphotosync-electron",
  "version": "1.0.9",
  "description": "一刻相册同步 - Electron Desktop App",
  "main": "main.js",
  "author": {
    "name": "Baidu",
    "email": "xRetia@users.noreply.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xRetia/BaiduPhotoSync.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder",
    "release": "electron-builder --publish always"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^24.13.3"
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "build": {
    "appId": "com.baidu.baiduphotosync",
    "productName": "一刻相册同步",
    "executableName": "BaiduPhotoSync",
    "copyright": "Copyright © 2026 Baidu",
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "src/**/*",
      "renderer/**/*",
      "assets/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "xRetia",
        "repo": "BaiduPhotoSync"
      }
    ],
    "win": {
      "icon": "yike_sync.ico",
      "publisherName": "Baidu",
      "target": [
        "nsis"
      ],
      "artifactName": "baiduphotosync-electron-${version}-setup-${arch}.${ext}"
    },
    "nsis": {
      "shortcutName": "一刻相册同步",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "yike_sync.ico",
      "uninstallerIcon": "yike_sync.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.photography",
      "artifactName": "baiduphotosync-electron-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "artifactName": "baiduphotosync-electron-${version}-linux-${arch}.${ext}"
    }
  }
}
